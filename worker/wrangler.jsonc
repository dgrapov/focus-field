{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "focus-field-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "focus-field-db",
      "database_id": "45dd86d7-de7b-4816-98a0-483178e206df"
    }
  ],
  "vars": {
    // Public Turnstile site key (widget for dgrapov.github.io, Managed mode).
    // The page has its own copy (TURNSTILE_SITE_KEY in index.html); keep the two in step.
    // The SECRET is never put here: production uses `wrangler secret put TURNSTILE_SECRET`,
    // local dev passes Cloudflare's public test secret on the command line (npm run dev:test).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF9oxrfRnFcUb0OU"
  }
}
