{
  // Focus Field enroll Worker (src/enroll.ts): an OPTIONAL owner page for minting access codes, on the same D1.
  // Cloudflare Access (One-time PIN by email) must cover this whole hostname; the Worker re-checks Access's JWT.
  //   npx wrangler deploy -c wrangler.enroll.jsonc        (https://focus-field-enroll.dgrapov.workers.dev/enroll)
  // Secrets (typed by the owner, never in this file; the repo is public):
  //   npx wrangler secret put ACCESS_TEAM_DOMAIN -c wrangler.enroll.jsonc    https://<team>.cloudflareaccess.com
  //   npx wrangler secret put ACCESS_AUD -c wrangler.enroll.jsonc            the Access application's AUD tag
  //   npx wrangler secret put ENROLL_ADMIN_EMAILS -c wrangler.enroll.jsonc   comma-separated admin emails
  // Without all three it answers 404. The public MCP Worker does not depend on it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "focus-field-enroll",
  "main": "src/enroll.ts",
  "compatibility_date": "2026-10-20",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "focus-field-db",
      "database_id": "45dd86d7-de7b-4816-98a0-483178e206df"
    }
  ]
}
